# Aerchain RFx Intelligence — Environment Configuration
# ======================================================

# 1. Groq Cloud API Key (RECOMMENDED & PRIORITIZED)
# ==================================================
# Provides free, ultra-low latency access to open-source models with genuine tool-calling:
# - llama-3.3-70b-versatile (Recommended default: 70B parameter reasoning, 128k context)
# - llama-3.1-8b-instant (Fast, lightweight)
# Get your free key instantly at: https://console.groq.com/keys (No credit card required)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional: Override the Groq / Copilot model name
# COPILOT_MODEL=llama-3.3-70b-versatile

# 2. Google Gemini API Key (Alternative)
# ======================================
# Get your API key from: https://aistudio.google.com/ or https://ai.google.dev/
GOOGLE_GENERATIVEAI_API_KEY=your_gemini_api_key_here
# Alternative accepted aliases:
# GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.0-flash

# 3. OpenAI API Key (Alternative)
# ===============================
# Get your API key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-proj-your_openai_api_key_here
